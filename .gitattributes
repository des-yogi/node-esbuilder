# Normalize all text files to LF in the repo and in the working copy
* text=auto eol=lf

# Binary files: never touch
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.avif binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.mp4  binary
*.webm binary
*.ogv  binary
