{
  "name": "node-bem-starter",
  "version": "0.1.0",
  "description": "A modern Node.js project builder: esbuild & BEM notation",
  "author": "Igor Beliakovski",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/des-yogi/node-esbuilder"
  },
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_ENV=production FORCE_COLOR=2 node scripts/build.mjs",
    "dev": "cross-env FORCE_COLOR=2 node scripts/dev-server.mjs",
    "start": "npm run dev",
    "gen:style": "cross-env FORCE_COLOR=2 node scripts/generateStyle.mjs",
    "lint:css": "stylelint \"src/**/*.scss\"",
    "lint:js": "eslint \"src/**/*.js\"",
    "create-block": "cross-env FORCE_COLOR=2 node createBlock.mjs",
    "img:opt": "cross-env FORCE_COLOR=2 node scripts/img-opt.mjs"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "browser-sync": "^3.0.4",
    "chalk": "^5.6.2",
    "chokidar": "^4.0.1",
    "cross-env": "^7.0.3",
    "esbuild": "^0.27.1",
    "eslint": "^9.28.0",
    "postcss": "^8.5.6",
    "postcss-extract-media-query": "^3.2.0",
    "postcss-inline-svg": "^6.0.0",
    "postcss-sort-media-queries": "^5.2.0",
    "sass": "^1.89.2",
    "sharp": "^0.34.5",
    "stylelint": "^16.20.0"
  },
  "dependencies": {
    "autosize": "^6.0.1",
    "bootstrap": "^5.3.8"
  }
}
