{
  "name": "node-bem-starter",
  "version": "0.3.0",
  "description": "A modern Node.js project builder: esbuild & BEM notation",
  "author": "Igor Beliakovski",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/des-yogi/node-esbuilder"
  },
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_ENV=production FORCE_COLOR=2 node scripts/build.mjs",
    "dev": "cross-env FORCE_COLOR=2 node scripts/dev-server.mjs",
    "start": "npm run dev",
    "create-block": "cross-env FORCE_COLOR=2 node createBlock.mjs",
    "gen:style": "cross-env FORCE_COLOR=2 node scripts/generateStyle.mjs",
    "lint:css": "stylelint \"src/**/*.scss\"",
    "lint:css:fix": "stylelint \"src/**/*.scss\" --fix",
    "lint:js": "eslint \"src/**/*.js\"",
    "lint:js:fix": "eslint \"src/**/*.js\" --fix",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:fix": "npm run lint:js:fix && npm run lint:css:fix",
    "img:opt": "cross-env FORCE_COLOR=2 node scripts/img-opt.mjs"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "autoprefixer": "^10.4.21",
    "browser-sync": "^3.0.4",
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.27.5",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "postcss": "^8.5.6",
    "postcss-calc": "^10.1.1",
    "postcss-extract-media-query": "^3.2.0",
    "postcss-inline-svg": "^6.0.0",
    "postcss-pxtorem": "^6.1.0",
    "postcss-scss": "^4.0.9",
    "postcss-sort-media-queries": "^6.3.3",
    "prettier": "^3.8.1",
    "sass": "^1.98.0",
    "sharp": "^0.34.5",
    "stylelint": "^17.6.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "svgo": "^4.0.1"
  },
  "dependencies": {
    "@coreui/coreui": "^5.6.1",
    "autosize": "^6.0.1"
  }
}
