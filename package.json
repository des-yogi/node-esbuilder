{
  "name": "node-bem-starter",
  "version": "0.1.0",
  "description": "Современный сборщик проектов на Node, esbuild + БЭМ",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_ENV=production node scripts/build.mjs",
    "dev": "node scripts/dev-server.mjs",
    "start": "npm run dev",
    "gen:style": "node scripts/generateStyle.mjs",
    "lint:css": "stylelint \"src/**/*.scss\"",
    "lint:js": "eslint \"src/**/*.js\"",
    "create-block": "node createBlock.mjs"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "browser-sync": "^3.0.4",
    "chalk": "^5.6.2",
    "chokidar": "^4.0.1",
    "cross-env": "^7.0.3",
    "esbuild": "^0.27.1",
    "eslint": "^9.28.0",
    "postcss": "^8.5.6",
    "postcss-extract-media-query": "^3.2.0",
    "postcss-inline-svg": "^6.0.0",
    "postcss-sort-media-queries": "^5.2.0",
    "sass": "^1.89.2",
    "stylelint": "^16.20.0"
  }
}
